# Copie ce fichier en .env (en local) ou /opt/money/.env (sur le VPS). Ne jamais le commiter.

# Postgres (sur le VPS : 127.0.0.1:5432, mot de passe dans /opt/money/db/.env)
DATABASE_URL=postgres://money:MOT_DE_PASSE@127.0.0.1:5432/money

# Clé de chiffrement des secrets en base (32 octets en hex) : openssl rand -hex 32
ENCRYPTION_KEY=

# Session de l'app : openssl rand -hex 32
SESSION_SECRET=

# Compte unique, généré par `npm run admin:create`
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

# Enable Banking (https://enablebanking.com/cp/applications)
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=/opt/money/keys/enablebanking.pem
# Nom exact de la banque tel que renvoyé par GET /aspsps?country=FR
ENABLE_BANKING_ASPSP_NAME=Caisse d'Epargne Rhône Alpes
ENABLE_BANKING_ASPSP_COUNTRY=FR

# URL publique de l'app (sert au retour de la banque)
APP_URL=https://money.johanpoyet.fr
